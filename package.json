{
  "name": "oneshot-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch-path=server.ts server.ts",
    "setup": "node scripts/install.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down -v",
    "test:integration": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "npm run build-storybook && playwright test -c tests/storybook/playwright.config.ts",
    "test:storybook:update": "npm run build-storybook && playwright test -c tests/storybook/playwright.config.ts --update-snapshots",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@react-router/express": "8.5.0",
    "@react-router/node": "8.5.0",
    "express": "5.3.0",
    "marked": "18.1.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.0",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/react": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "storybook": "10.6.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
